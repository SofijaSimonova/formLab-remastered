# Copy this file to .env and fill in real values.
# docker-compose reads .env automatically for variable substitution below.

SUPABASE_DB_URL=jdbc:postgresql://your-supabase-host:5432/postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=

JWT_SECRET=

GEMINI_API_KEY=

# Redis - used by both backend and ai-service.
# Leave host/port as-is and password empty for local docker-compose Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# Kafka - used by both backend and ai-service.
# Leave as-is for local docker-compose Kafka (PLAINTEXT, no auth).
# For a managed broker (e.g. Aiven), set bootstrap-servers to its host:port,
# security protocol to SASL_SSL, and fill in the SASL/SSL values below.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_JAAS_CONFIG=
KAFKA_SSL_TRUSTSTORE_TYPE=
KAFKA_SSL_TRUSTSTORE_CERTIFICATES=

# Origins allowed to call the backend, comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# URLs the browser will use to reach the backend/ai-service - baked into the
# frontend bundle at build time, so these must be reachable from the browser,
# not just from inside the docker network.
VITE_API_BASE_URL=http://localhost:8080
VITE_AI_API_BASE_URL=http://localhost:8090
