# Copy this file to .env and fill in real values.
# docker-compose reads .env automatically for variable substitution below.

SUPABASE_DB_URL=jdbc:postgresql://your-supabase-host:5432/postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=

JWT_SECRET=

GEMINI_API_KEY=

# Origins allowed to call the backend, comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# URLs the browser will use to reach the backend/ai-service - baked into the
# frontend bundle at build time, so these must be reachable from the browser,
# not just from inside the docker network.
VITE_API_BASE_URL=http://localhost:8080
VITE_AI_API_BASE_URL=http://localhost:8090
